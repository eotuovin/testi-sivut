{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "lib": ["ES2020", "DOM"], "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "isolatedModules": true, "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}

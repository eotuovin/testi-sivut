DATABASE_URL=postgresql+psycopg2://luuri:luuri@db:5432/luuri
SESSION_SECRET=change-me-long-random
BOOTSTRAP_ADMIN_EMAIL=admin@example.fi
BOOTSTRAP_ADMIN_PASSWORD=change-me

# Prospecting (PRH open data needs no key; Claude is optional but finds decision-makers)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
BRAVE_SEARCH_API_KEY=

# Integrations – targets are configured in the UI; secrets stay here
MOVINGFIRM_BACKEND_URL=
MOVINGFIRM_INTERNAL_TOKEN=
TWENTY_API_URL=
TWENTY_API_KEY=
WEBHOOK_SIGNING_SECRET=
ANALYTICS_UX_EVENTS_URL=

# Mira (Ilari's agent) instead of Anthropic for prospecting
MIRA_AGENT_URL=
MIRA_AGENT_TOKEN=

# Telephony – bridged calls via 46elks (rings your phone first, then the customer)
TELEPHONY_PROVIDER=
TELEPHONY_FROM_NUMBER=
ELKS_API_USER=
ELKS_API_PASSWORD=
TELEPHONY_RECORD_CALLS=false

# Google Calendar (integration target google_calendar)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# Mira via the mirarun hub (preferred over MIRA_AGENT_URL / ANTHROPIC_API_KEY)
MIRARUN_URL=
MIRARUN_SESSION_TOKEN=
MIRA_PROSPECTOR_AGENT=luuri-prospector
MIRA_CALL_ANALYST_AGENT=sales-call-analyst
MIRA_FUNNEL_ANALYST_AGENT=sales-funnel-analyst

# Speech-to-text (OpenAI-compatible /audio/transcriptions)
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=Systran/faster-whisper-large-v3
STT_LANGUAGE=fi
ANALYZE_NOTES=true
TRANSCRIPT_RETENTION_DAYS=180
